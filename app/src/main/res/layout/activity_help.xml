<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:text="@string/help_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/nunito_bold" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <!-- Section 1: What is Text Actions? -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_what_is"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/header_what_is"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="56dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_lightning" app:tint="?attr/colorOnSurface" />
                        <TextView android:id="@+id/title_what_is" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/help_section_what_is" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/nunito_bold" />
                        <ImageView android:id="@+id/chevron_what_is" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/content_what_is" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="60dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/help_what_is_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingMultiplier="1.25" android:fontFamily="@font/nunito_regular" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: How to use (Quick Start) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quick_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/header_quick_start" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:background="?attr/selectableItemBackground" android:minHeight="56dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_grid" app:tint="?attr/colorOnSurface" />
                        <TextView android:id="@+id/title_quick_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/help_section_quick_start" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/nunito_bold" />
                        <ImageView android:id="@+id/chevron_quick_start" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/content_quick_start" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="60dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/help_quick_start_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingMultiplier="1.25" android:fontFamily="@font/nunito_regular" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Available Actions -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/header_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:background="?attr/selectableItemBackground" android:minHeight="56dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_translate" app:tint="?attr/colorOnSurface" />
                        <TextView android:id="@+id/title_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/help_section_actions" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/nunito_bold" />
                        <ImageView android:id="@+id/chevron_actions" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/content_actions" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="60dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/help_actions_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingMultiplier="1.25" android:fontFamily="@font/nunito_regular" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Notes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/header_notes" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:background="?attr/selectableItemBackground" android:minHeight="56dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_bell" app:tint="?attr/colorOnSurface" />
                        <TextView android:id="@+id/title_notes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/help_section_notes" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/nunito_bold" />
                        <ImageView android:id="@+id/chevron_notes" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/content_notes" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="60dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/help_notes_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingMultiplier="1.25" android:fontFamily="@font/nunito_regular" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 5: Tips -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/header_tips" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:background="?attr/selectableItemBackground" android:minHeight="56dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp"
                            android:src="@drawable/ic_check_circle" app:tint="?attr/colorOnSurface" />
                        <TextView android:id="@+id/title_tips" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/help_section_tips" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" android:fontFamily="@font/nunito_bold" />
                        <ImageView android:id="@+id/chevron_tips" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/content_tips" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingStart="60dp" android:paddingEnd="20dp" android:paddingBottom="20dp" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/help_tips_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:lineSpacingMultiplier="1.25" android:fontFamily="@font/nunito_regular" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
