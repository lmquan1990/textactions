    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="settings_help">Help</string>
    <string name="settings_help_subtitle">How Image to Text works</string>
    <string name="help_section_what_is">What is Image to Text?</string>
    <string name="help_what_is_body">Image to Text is a system-wide shortcut that lets you perform smart actions on any selected text — without copying, pasting, or switching apps.\n\nSelect text anywhere, tap Image to Text from the popup menu, and get instant results.</string>
    <string name="help_section_quick_start">How to Use</string>
    <string name="help_quick_start_body">1. Select (highlight) any text in any app — browser, messages, notes, etc.\n\n2. Tap "Image to Text" from the selection menu that appears.\n\n3. Choose an action — the app handles the rest instantly.</string>
    <string name="help_section_actions">Available Actions</string>
    <string name="help_actions_body">Contextual (based on text type):\n• Call — from phone numbers\n• SMS — send a message\n• Email — compose an email\n• Open Link — open URLs\n• Map / Directions — from addresses\n• Calendar — add events from dates\n• Reminder — set a reminder\n• Save Contact — from phone numbers\n• Open Chat (Zalo, Telegram, Messenger) — from phone numbers\n\nUtility (always available):\n• Search — search the web\n• Ask AI — opens ChatGPT, Gemini, Perplexity, etc. (if installed)\n• Search Media — find on YouTube, Spotify, etc.\n• Translate — translate text (works offline)\n• Copy — copy to clipboard\n• Save Note — save to your notes\n• Quick Share — share instantly\n• Format Text — clean up formatting\n• Create QR — generate a QR code\n• Shorten Link — for URLs</string>
    <string name="help_section_notes">Notes</string>
    <string name="help_notes_body">• Text must be selected for Image to Text to appear.\n• Some apps (Instagram, TikTok, etc.) may hide the selection menu — try long-pressing the text again.\n• Actions shown depend on what is detected in the selected text.\n• Translate works on-device — no internet required.</string>
    <string name="help_section_tips">Tips</string>
    <string name="help_tips_body">• Keep selections short and focused for better results.\n• Works best in browsers, messaging apps, notes, and PDF readers.\n• For addresses, include the street name for accurate map results.\n• For phone numbers, international format (+84…) works best.\n• Use Quick Note to quickly capture information while reading.</string>

    <!-- About -->
    <string name="about_version">Version %1$s — Built with ♥ in Vietnam</string>
    <string name="about_description">Image to Text started as a personal tool — I kept needing to quickly copy, translate, or extract info from text while using my phone, but existing apps were either too bloated or full of ads.\n\nSo I built the app I actually wanted to use.\n\nNo ads. No tracking. No subscriptions. Just a fast, clean tool that respects your time and privacy.</string>
    <string name="about_built_with">Developer  FreeUp Apps</string>
